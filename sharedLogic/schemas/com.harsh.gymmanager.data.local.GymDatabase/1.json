    "views": [
      {
        "viewName": "member_summary",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT m.id AS memberId, m.name, m.phone, m.photoPath, m.isArchived,\n            (SELECT MAX(ms.endDate) FROM memberships ms WHERE ms.memberId = m.id) AS latestEndDate,\n            (SELECT COALESCE(SUM(ms.price - ms.discount), 0) FROM memberships ms WHERE ms.memberId = m.id)\n                - (SELECT COALESCE(SUM(p.amount), 0) FROM payments p\n                    INNER JOIN memberships ms ON ms.id = p.membershipId\n                    WHERE ms.memberId = m.id) AS amountDue\n        FROM members m"
      }
    ],
