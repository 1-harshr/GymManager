# Which Supabase project the web app talks to. Without these it uses local Supabase (`supabase start`).
# Copy to .env.local (not committed) to point at a hosted project.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Show "Continue with Google". Google must be enabled in that Supabase project, with this site's
# address in its redirect URLs.
VITE_GOOGLE_SIGN_IN=false
