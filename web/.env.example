# Copy to .env.docker (local Supabase, `npm run dev:local`) and .env.staging (hosted, `npm run dev:remote`).
# Neither is committed.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GOOGLE_SIGN_IN=false
# Mobile number sign-in; off unless true, but always offered while Google sign-in is off.
VITE_PHONE_SIGN_IN=false
