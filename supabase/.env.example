# Copy to supabase/.env (not committed) and fill in. config.toml reads these with env(...).

# Sign in with Apple: the iOS app's bundle ID (PRODUCT_BUNDLE_IDENTIFIER in iosApp/Configuration/Config.xcconfig).
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=com.harsh.gymmanager.GymManager

# Google sign-in: "<web client ID>,<iOS client ID>" from Google Cloud > APIs & Services > Credentials,
# and the web client's secret.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
